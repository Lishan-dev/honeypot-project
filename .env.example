# Honeypot service
HONEYPOT_HOST=127.0.0.1
HONEYPOT_PORT=2222
MAX_AUTH_ATTEMPTS=5
CONNECTION_TIMEOUT_SECONDS=60
MAX_LINE_LENGTH=1024
FAKE_SHELL_ENABLED=true
MAX_FAKE_SHELL_COMMANDS=20

# Database
DB_PATH=./data/honeypot.db

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
